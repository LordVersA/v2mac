{
  "sourceLanguage": "en",
  "strings": {
    "Connect or disconnect V2Mac.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2Mac را وصل یا قطع کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить или отключить V2Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接或断开 V2Mac。"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Turn V2Mac On or Off": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روشن یا خاموش کردن V2Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить или выключить V2Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭 V2Mac"
          }
        }
      }
    },
    "V2Mac": {
      "shouldTranslate": false
    },
    "Connect": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل شو"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال اتصال…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение…"
          }
        }
      }
    },
    "Disconnect": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع اتصال"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ناموفق"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка"
          }
        }
      }
    },
    "Shows the connection and turns it on or off.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت اتصال را نشان می‌دهد و آن را روشن یا خاموش می‌کند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示连接状态并可开关连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает подключение и включает или выключает его."
          }
        }
      }
    }
  },
  "version": "1.0"
}
