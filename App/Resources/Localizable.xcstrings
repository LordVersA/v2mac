          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流量配额已用完（已用 %1$@ / %2$@）。"
          }
        }
      }
    },
    "These configs are already in Custom Configs.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کانفیگ‌ها از قبل در کانفیگ‌های دستی هستند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
