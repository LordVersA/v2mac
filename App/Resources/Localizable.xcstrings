      }
    },
    "Also match every app with “%@” in its name" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر برنامه‌ای که «%@» در نامش دارد هم تطبیق داده شود"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также все приложения с «%@» в названии"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也匹配名称中含“%@”的所有应用"
          }
        }
      }
    },
    "Also replaces a custom config's own fallback. Direct mode sends everything direct." : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جایگزین مسیر پیش‌فرض پیکربندی سفارشی هم می‌شود. حالت مستقیم همه‌چیز را مستقیم می‌فرستد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также заменяет запасной маршрут собственного конфига. В режиме «Напрямую» всё идёт напрямую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也会替代自定义配置自身的回退。直连模式下所有流量都直连。"
          }
        }
      }
    },
    "An address or a range, IPv4 or IPv6" : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک آدرس یا محدوده، IPv4 یا IPv6"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес или диапазон, IPv4 или IPv6"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地址或范围，IPv4 或 IPv6"
          }
        }
      }
    },
    "An earlier rule already matches the same traffic, so this one never does." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانونی بالاتر همین ترافیک را تطبیق می‌دهد، پس این قانون هرگز تطبیق نمی‌یابد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более раннее правило уже совпадает с тем же трафиком, поэтому это не срабатывает никогда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前面的规则已匹配相同流量，因此这条规则永远不会生效。"
          }
        }
      }
    },
    "An older version saved an administrator password. V2Mac no longer reads or uses it. Remove the old Keychain entry; macOS may ask for permission." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌ای قدیمی رمز مدیر را ذخیره کرده است. V2Mac دیگر آن را نمی‌خواند یا استفاده نمی‌کند. ورودی قدیمی زنجیره کلید را حذف کنید؛ ممکن است macOS اجازه بخواهد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старая версия сохранила пароль администратора. V2Mac больше не читает и не использует его. Удалите старую запись из Связки ключей; macOS может запросить разрешение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧版本曾保存管理员密码。V2Mac 不再读取或使用它。请删除旧的钥匙串条目；macOS 可能会要求授权。"
          }
        }
      }
    },
    "and its subdomains" : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "و زیردامنه‌هایش"
