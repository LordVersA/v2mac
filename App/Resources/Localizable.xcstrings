          }
        }
      }
    },
    "%lld entries for a new %@ rule": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld مورد برای یک قانون %2$@ جدید"
          }
        },
        "ru": {
