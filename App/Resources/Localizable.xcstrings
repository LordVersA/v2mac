    "Browsers then fall back to TCP, so their host names reach the rules above." : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرورگرها به TCP برمی‌گردند تا نام میزبان‌هایشان به قانون‌های بالا برسد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузеры переходят на TCP, и имена хостов доходят до правил выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器会改用 TCP，这样其主机名就能交给上面的规则处理。"
          }
        }
      }
    },
    "Browsers try QUIC (UDP 443) first. Blocking it makes them use TCP, whose site names the rules can read." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرورگرها اول QUIC (UDP 443) را امتحان می‌کنند. مسدود کردن آن باعث می‌شود از TCP استفاده کنند که قانون‌ها نام سایتش را می‌خوانند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузеры сначала пробуют QUIC (UDP 443). Его блокировка заставляет их использовать TCP, где правила видят имена сайтов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器会先尝试 QUIC（UDP 443）。阻止它会让浏览器改用 TCP，规则可以读取其网站名称。"
          }
        }
      }
    },
