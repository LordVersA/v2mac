    "No rules yet. Every connection follows the routing mode.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز قانونی نیست. همه‌ی اتصال‌ها از حالت مسیریابی پیروی می‌کنند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил пока нет. Все подключения следуют режиму маршрутизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有规则。所有连接都按路由模式处理。"
          }
        }
      }
    },
    "Move Up": {
