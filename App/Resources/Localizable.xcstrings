            "state" : "translated",
            "value" : "Tor 中继"
          }
        }
      }
    },
    "Total" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کل"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всего"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总计"
          }
        }
      }
    },
    "Traffic no rule matched goes here. “Follow mode” leaves it to the routing mode, which also replaces a custom config's own fallback." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترافیکی که با هیچ قانونی تطبیق نیافت به اینجا می‌آید. «پیروی از حالت» آن را به حالت مسیریابی می‌سپارد که جایگزین مسیر پیش‌فرض پیکربندی سفارشی هم می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюда идёт трафик, не совпавший ни с одним правилом. «По режиму» оставляет его режиму маршрутизации, который заменяет и собственный запасной путь пользовательской конфигурации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未被任何规则匹配的流量走这里。“跟随模式”交给路由模式处理，这也会替代自定义配置自身的兜底出站。"
          }
        }
      }
    },
    "Traffic running out" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترافیک رو به اتمام"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трафик заканчивается"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流量即将用完"
          }
        }
      }
    },
    "Traffic that matches no rule" : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترافیکی که با هیچ قانونی جور نیست"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
