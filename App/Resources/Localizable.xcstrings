    "Made on %@ with V2Mac %@: %lld subscriptions and %lld servers. What is missing here is added, nothing is removed, and the settings are replaced by the backup's.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Made on %1$@ with V2Mac %2$@: %3$lld subscriptions and %4$lld servers. What is missing here is added, nothing is removed, and the settings are replaced by the backup's."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساخته‌شده در %1$@ با V2Mac %2$@: %3$lld اشتراک و %4$lld سرور. هرچه اینجا نیست اضافه می‌شود، چیزی حذف نمی‌شود و تنظیمات با تنظیمات پشتیبان جایگزین می‌شوند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создана %1$@ в V2Mac %2$@: подписок — %3$lld, серверов — %4$lld. Недостающее будет добавлено, ничего не удалится, настройки заменятся настройками из копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "于 %1$@ 由 V2Mac %2$@ 创建：%3$lld 个订阅和 %4$lld 个服务器。此处缺少的内容会被添加，不会删除任何内容，设置将被备份中的设置替换。"
          }
        }
      }
    },
