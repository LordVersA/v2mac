    "A mini VM whose exit stops working is blocked until you pick another server; it never switches by itself." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماشین مجازی کوچکی که خروجی‌اش از کار بیفتد تا وقتی سرور دیگری انتخاب کنید مسدود می‌ماند؛ هرگز خودش سرور را عوض نمی‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мини-ВМ, чей выход перестал работать, блокируется, пока вы не выберете другой сервер; сама она сервер не меняет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口停止工作的迷你虚拟机会被阻断，直到你选择另一台服务器；它从不自行切换。"
          }
        }
      }
    },
    "A regular expression" : {
