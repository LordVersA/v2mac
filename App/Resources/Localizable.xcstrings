    "A subscription replaces its servers on every update, so the edited copy is saved in Custom Configs.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک با هر به‌روزرسانی سرورهایش را عوض می‌کند، پس نسخه ویرایش‌شده در کانفیگ‌های دستی ذخیره می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка заменяет свои серверы при каждом обновлении, поэтому изменённая копия сохраняется в «Свои конфигурации»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅每次更新都会替换其服务器，因此编辑后的副本会保存在“自定义配置”中。"
          }
        }
      }
    },
