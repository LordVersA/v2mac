          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些配置已在“自定义配置”中。"
          }
        }
      }
    },
    "They are added to the Custom Configs group.": {
      "localizations": {
        "fa": {
