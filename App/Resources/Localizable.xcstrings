    "Apps using the proxy port" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌هایی که از پورت پروکسی استفاده می‌کنند"
          }
        },
        "ru" : {
          "stringUnit" : {
