    "This backup cannot be restored.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پشتیبان قابل بازیابی نیست."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту резервную копию нельзя восстановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复此备份。"
          }
        }
      }
    },
    "This backup was made by a newer V2Mac. Update V2Mac to restore it.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پشتیبان با نسخه جدیدتری از V2Mac ساخته شده است. برای بازیابی، V2Mac را به‌روز کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия создана более новой версией V2Mac. Обновите V2Mac, чтобы её восстановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由较新版本的 V2Mac 创建。请更新 V2Mac 后再恢复。"
          }
        }
      }
    },
    "This group contains the active server. V2Mac will disconnect.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گروه سرور فعال را دارد. V2Mac قطع خواهد شد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой группе активный сервер. V2Mac отключится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分组包含当前服务器，V2Mac 将断开连接。"
          }
        }
      }
    },
    "This is not a V2Mac backup.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
