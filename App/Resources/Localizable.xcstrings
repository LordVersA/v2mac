    "Approve V2Mac in System Settings → Login Items." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac را در تنظیمات سیستم ← موارد ورود تأیید کنید."
          }
        },
        "ru" : {
          "stringUnit" : {
