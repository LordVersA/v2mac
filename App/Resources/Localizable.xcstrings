          }
        }
      }
    },
    "What's New" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تازه‌ها"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что нового"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新功能"
          }
        }
      }
    },
    "Where apps that were set to use V2Mac's proxy port themselves go, before any rule. Not used while the system proxy is on, since then every app comes through that port." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌هایی که خودشان برای استفاده از پورت پروکسی V2Mac تنظیم شده‌اند، پیش از هر قانونی به کجا بروند. وقتی پروکسی سیستم روشن است استفاده نمی‌شود، چون آن‌وقت همهٔ برنامه‌ها از این پورت می‌آیند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Куда идут приложения, сами настроенные на порт прокси V2Mac, до любых правил. Не действует при включённом системном прокси: тогда через этот порт идут все приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自行设置为使用 V2Mac 代理端口的应用在任何规则之前的去向。系统代理开启时不使用，因为那时所有应用都经过该端口。"
          }
        }
      }
    },
    "Where it goes" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کجا می‌رود"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Куда идёт"
          }
        },
        "zh-Hans" : {
