    "The release has no SHA-256 checksum." : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این انتشار چک‌سام SHA-256 ندارد."
          }
        },
        "ru" : {
