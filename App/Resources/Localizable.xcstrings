    "The new version failed its signature check.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه جدید در بررسی امضا رد شد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая версия не прошла проверку подписи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本未通过签名检查。"
          }
        }
      }
    },
    "The port hopping interval must be a number of seconds.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازه پرش پورت باید تعداد ثانیه باشد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интервал перебора портов должен быть числом секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口跳跃间隔必须是秒数。"
          }
        }
      }
    },
    "The port must be a number from 1 to 65535.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پورت باید عددی از ۱ تا ۶۵۵۳۵ باشد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
