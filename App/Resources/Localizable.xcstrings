    "Measures the real delay of the servers in a group, or of every server, and returns those that answered, fastest first." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأخیر واقعی سرورهای یک گروه یا همهٔ سرورها را می‌سنجد و آن‌هایی را که پاسخ دادند، از سریع‌ترین، برمی‌گرداند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
