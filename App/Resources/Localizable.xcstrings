    "What should happen to the traffic you pick?" : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با ترافیکی که انتخاب می‌کنید چه شود؟"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
