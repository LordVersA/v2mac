    "—" : {
      "shouldTranslate" : false
    },
    "“%@” is not on this Mac: this rule's traffic is blocked." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» در این مک نیست: ترافیک این قانون مسدود است."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» нет на этом Mac: трафик этого правила блокируется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上没有“%@”：此规则的流量被阻止。"
          }
        }
      }
    },
    "“%@” is not on this Mac: this rule's traffic uses the current server." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» در این مک نیست: ترافیک این قانون از سرور فعلی می‌رود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» нет на этом Mac: трафик этого правила идёт через текущий сервер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上没有“%@”：此规则的流量使用当前服务器。"
          }
        }
      }
    },
    "\"Lost or failed\" covers a server that will not connect, a core that stopped and could not be restarted, and a busy port. These stay silent while a V2Mac window is in front." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«قطع یا ناموفق» شامل سروری است که وصل نمی‌شود، هسته‌ای که متوقف شد و دوباره راه نیفتاد، و پورتی که اشغال است. وقتی پنجره‌ای از V2Mac جلو است، این‌ها بی‌صدا می‌مانند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Разрыв или сбой» — это сервер, к которому не удаётся подключиться, ядро, которое остановилось и не перезапустилось, и занятый порт. Пока окно V2Mac на переднем плане, эти уведомления не приходят."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“断开或失败”包括无法连接的服务器、停止后无法重启的内核以及被占用的端口。V2Mac 窗口在前台时不会提醒。"
          }
        }
      }
    },
