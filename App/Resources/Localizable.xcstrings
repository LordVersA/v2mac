          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入 %lld 条规则。请检查后点按“应用”。"
          }
        }
      }
    },
    "Imported %lld rules. Skipped, they use another proxy or a chain: %@.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld قانون وارد شد. رد شده، چون از پروکسی یا زنجیره‌ی دیگری استفاده می‌کنند: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировано правил: %lld. Пропущены, так как используют другой прокси или цепочку: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
