    },
    "On: only the connection can reach the internet" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روشن: فقط اتصال به اینترنت دسترسی دارد"
          }
        },
        "ru" : {
          "stringUnit" : {
