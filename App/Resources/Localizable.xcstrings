    },
    "The traffic quota is used up (%@ of %@ used).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The traffic quota is used up (%1$@ of %2$@ used)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سهمیه ترافیک تمام شده است (%1$@ از %2$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
