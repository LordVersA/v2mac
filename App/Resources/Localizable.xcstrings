    "V2Mac needs administrator access for TUN mode, the system proxy or the kill switch.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2Mac برای حالت TUN، پروکسی سیستم یا کلید قطع اضطراری به دسترسی مدیر نیاز دارد."
