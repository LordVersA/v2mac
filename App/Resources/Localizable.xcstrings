    "V2Mac is free and has no ads. If it helps you, share it with someone who needs it." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac رایگان است و تبلیغ ندارد. اگر به کارتان آمد، آن را با کسی که نیاز دارد به اشتراک بگذارید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac бесплатна и без рекламы. Если она вам помогает, поделитесь ею с теми, кому она нужна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac 免费且没有广告。如果它对你有帮助，请分享给需要的人。"
          }
        }
