          }
        }
      }
    },
    "Approve V2Mac's privileged helper in System Settings → General → Login Items & Extensions, then reconnect." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمک‌برنامه دارای دسترسی مدیر V2Mac را در تنظیمات سیستم ← عمومی ← موارد ورود و افزونه‌ها تأیید کنید، سپس دوباره وصل شوید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрите привилегированный помощник V2Mac в Системные настройки → Основные → Объекты входа и расширения, затем подключитесь снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置 → 通用 → 登录项与扩展中批准 V2Mac 的特权辅助程序，然后重新连接。"
          }
        }
