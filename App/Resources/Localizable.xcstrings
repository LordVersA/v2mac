    },
    "Rules are checked from the top; the first that matches decides where traffic goes." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانون‌ها از بالا بررسی می‌شوند؛ نخستین قانونِ منطبق تعیین می‌کند ترافیک کجا برود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила проверяются сверху; первое совпавшее решает, куда идёт трафик."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则从上往下检查；第一条匹配的规则决定流量去向。"
          }
        }
      }
    },
    "Rules Only" : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط قوانین"
          }
        },
        "ru" : {
          "stringUnit" : {
