    "The license key joins another device to this account; keep it private.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کلید لایسنس، دستگاه دیگری به این حساب وصل می‌شود؛ آن را به کسی ندهید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По лицензионному ключу к этому аккаунту можно подключить другое устройство; не передавайте его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可证密钥可将其他设备加入此账户，请妥善保管。"
          }
        }
      }
    },
    "The link asks to skip the certificate check (allowInsecure). This server connects only while \"Allow insecure servers\" is on in Settings → Connection, unless its certificate is valid": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لینک می‌خواهد بررسی گواهی نادیده گرفته شود (allowInsecure). این سرور فقط وقتی وصل می‌شود که «اجازه سرورهای ناامن» در تنظیمات ← اتصال روشن باشد، مگر اینکه گواهی‌اش معتبر باشد"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка просит пропустить проверку сертификата (allowInsecure). Этот сервер подключается, только если в «Настройки → Подключение» включено «Разрешить небезопасные серверы», либо если его сертификат действителен"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该链接要求跳过证书检查（allowInsecure）。除非其证书有效，否则只有在“设置 → 连接”中开启“允许不安全的服务器”时此服务器才能连接"
          }
        }
      }
    },
    "The new core failed its self-test: %@": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هسته جدید در خودآزمایی رد شد: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новое ядро не прошло самопроверку: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新内核自检失败：%@"
          }
        }
      }
    },
    "The new version could not be copied.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه جدید کپی نشد."
          }
