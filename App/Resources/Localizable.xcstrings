    },
    "Another app is using it. Choose another port in Settings." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه دیگری از آن استفاده می‌کند. در تنظیمات پورت دیگری انتخاب کنید."
          }
        },
        "ru" : {
