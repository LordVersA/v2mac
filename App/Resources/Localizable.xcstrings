    "Enter a number or a range such as %@. Until then %@ is used." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter a number or a range such as %1$@. Until then %2$@ is used."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک عدد یا محدوده مثل %1$@ وارد کنید. تا آن موقع %2$@ استفاده می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите число или диапазон, например %1$@. Пока используется %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入数字或范围，例如 %1$@。在此之前使用 %2$@。"
          }
        }
      }
    },
    "Enter a port between 1024 and 65535." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
