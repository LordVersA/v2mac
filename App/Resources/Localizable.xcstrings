          }
        }
      }
    },
    "Pings %lld random Cloudflare addresses on port %@, then tries the fastest %lld as %@. The server's name stays as SNI and Host." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld آدرس تصادفی Cloudflare روی پورت %2$@ پینگ می‌شوند، سپس %3$lld آدرس سریع‌تر به‌جای %4$@ امتحان می‌شوند. نام سرور به‌عنوان SNI و Host باقی می‌ماند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пингуются %1$lld случайных адресов Cloudflare на порту %2$@, затем %3$lld самых быстрых проверяются как %4$@. Имя сервера остаётся в SNI и Host."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 %1$lld 个随机 Cloudflare 地址的 %2$@ 端口进行 ping，然后把最快的 %3$lld 个作为 %4$@ 测试。服务器名称仍用作 SNI 和 Host。"
          }
        }
      }
    },
