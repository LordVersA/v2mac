        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回 HTTP %lld。"
          }
        }
      }
    },
    "The server in use is no longer in the subscription.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور در حال استفاده دیگر در اشتراک نیست."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используемого сервера больше нет в подписке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用的服务器已不在订阅中。"
          }
        }
      }
    },
    "The speed test downloads a large file through each server. It stops as soon as the speed levels off, so the whole file is never fetched.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تست سرعت از طریق هر سرور یک فایل بزرگ دانلود می‌کند. به‌محض ثابت شدن سرعت متوقف می‌شود، پس هیچ‌وقت کل فایل دریافت نمی‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тест скорости загружает через каждый сервер большой файл. Он останавливается, как только скорость выравнивается, поэтому файл никогда не загружается целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测速会通过每台服务器下载一个大文件。速度一稳定就停止，因此不会下载整个文件。"
          }
        }
      }
    },
    "The subscription URL is not valid.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرس اشتراک معتبر نیست."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный URL подписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅链接无效。"
          }
        }
      }
    },
    "The subscription contains no servers.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک هیچ سروری ندارد."
          }
