          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ جدید را در پس‌زمینه دانلود می‌کند و هنگام بستن V2Mac نصب می‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
